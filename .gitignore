# Environment and secrets
.env
.env.*

# Credential blobs (service-account keys etc.)
# NOTE: this used to be a bare `*.json`, which silently excluded
# frontend/package.json — a fresh clone could not `npm install`. `config.py` was
# excluded for the same reason and holds no secrets (those come from .env), so
# it is tracked now too.
*credentials*.json
*service-account*.json
gcp-*.json

